PORT=3000
CORS_ORIGIN=
JWT_SECRET=ganti-dengan-rahasia-acak-minimal-32-karakter
ADMIN_USER=admin
OWNER_NUMBER=628xxxxxxxxxx@s.whatsapp.net
BACKUP_RETENTION_DAYS=14

# --- Casaku QRIS (pembayaran otomatis) ---
# Checkout baru memakai QRIS dinamis kalau CASAKU_LICENSE_KEY *dan* CASAKU_QRIS_ID
# dua-duanya terisi. Kurang salah satu = jatuh ke QRIS statis, pembeli kirim bukti
# transfer, dan tiap order harus dikonfirmasi tangan dengan .paid.
CASAKU_LICENSE_KEY=
CASAKU_QRIS_ID=
CASAKU_WEBHOOK_SECRET=
CASAKU_PACKAGE_IDS=id.dana
CASAKU_QR_EXPIRY_MINUTES=15

# --- Jaringan ---
# Bawaannya 127.0.0.1: dashboard hanya bisa dibuka dari komputer ini, dan webhook
# dari luar TIDAK akan masuk. Isi 0.0.0.0 hanya kalau server ini memang perlu
# dijangkau dari jaringan/internet.
DASHBOARD_HOST=127.0.0.1
